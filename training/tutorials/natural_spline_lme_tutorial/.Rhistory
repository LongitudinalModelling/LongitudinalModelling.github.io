rm(list = ls())
## Install packages if needed
#install.packages(c("broom.mixed", "tidyverse", "lme4", "ggeffects", "splines", "marginaleffects", "emmeans", mgcv"))
#---------------------#
#### LOAD PACKAGES ####
#---------------------#
library(broom.mixed)
library(marginaleffects)
library(tidyverse)
library(ggeffects)
library(emmeans)
library(splines)
library(mgcv)
library(lme4)
#-------------------------#
#### Load BMI data set ####
#-------------------------#
dat <- read.csv((
"https://raw.githubusercontent.com/aelhak/ARMSC23/main/bmi_long.csv")) %>%
mutate(id = as.factor(id), sex = as.factor(sex))
## Quick look at the data
with(dat, plot(age, bmi))
dat %>% group_by(sex) %>% summarise(N = n_distinct(id))
dat %>% group_by(id) %>% count() %>% ungroup() %>%
summarise(median(n), min(n), max(n))
### Get male and female datasets
dat_m <- dat %>% filter(sex == "M")
dat_f <- dat %>% filter(sex == "F")
###############################################################################
# 1 - Natural Spline LME models with knots at equal quantiles of age: Females #
###############################################################################
### Fit natural spline mixed effects model with 3-6 df & pick best model based on BIC
ns_f <- map(3:6, possibly(~ { eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", .x, ") + (age | id ),
REML = F, data = dat_f)")))}, otherwise = NA_real_))
(ns_f_best <- ns_f[[which.min(unlist(map(ns_f, BIC)))]])
# Print knots positions
attr(terms(ns_f_best), "predvars")
### Plot predicted mean BMI trajectory in females
predict_response(ns_f_best, terms = c("age [all]"), margin = "marginalmeans") %>% plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory in Females") +
theme_classic()
#############################################################################
# 2 - Natural Spline LME models with knots at equal quantiles of age: Males #
#############################################################################
### Fit natural spline mixed effects model with 3-6 df & pick best model based on BIC
ns_m <- map(3:6, possibly(~ { eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", .x, ") + (age | id ),
REML = F, data = dat_m)")))}, otherwise = NA_real_))
(ns_m_best <- ns_m[[which.min(unlist(map(ns_m, BIC)))]])
# Print knots positions
attr(terms(ns_m_best), "predvars")
### Plot predicted mean BMI trajectory in females
predict_response(ns_m_best, terms = c("age [all]"), margin = "marginalmeans") %>% plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory in Males") +
theme_classic()
##########################################################################################
# 3 - Natural Spline LME models with knots at equal quantiles of age in males and females #
##########################################################################################
## Fit models wit with 3-6 df,
# include interactions between age and sex, and pick model with the lowest BIC
ns_mf <- map(3:6, possibly(~ { eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", .x, ") * sex + (age | id ),
REML = F, data = dat)")))}, otherwise = NA_real_))
(ns_mf_best <- ns_mf[[which.min(unlist(map(ns_mf, BIC)))]])
# Print knots positions
attr(terms(ns_mf_best), "predvars")
### Plot predicted mean BMI trajectory in males and females
anova(ns_mf_best)
library(lmerTest)
anova(ns_mf_best)
ns_mf <- map(3:6, possibly(~ { eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", .x, ") * sex + (age | id ),
REML = F, data = dat)")))}, otherwise = NA_real_))
(ns_mf_best <- ns_mf[[which.min(unlist(map(ns_mf, BIC)))]])
attr(terms(ns_mf_best), "predvars")
anova(ns_mf_best)
anova(ns_mf_best)[3,]
anova(ns_mf_best)[3,]
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.width  = 8,
fig.height = 5
)
rm(list = ls())
library(broom.mixed)        # tidy model summaries for mixed effects models
library(marginaleffects)    # marginal means, contrasts, and comparisons
library(tidyverse)          # data manipulation and plotting
library(ggeffects)          # predicted values and plots from models
library(emmeans)            # estimated marginal means
library(splines)            # ns() for natural spline basis functions
library(lme4)               # linear mixed effects models
library(lmerTest)          # p-values for linear mixed effects models
dat <- read.csv(
"https://raw.githubusercontent.com/LongitudinalModelling/fake_datasets/main/abcd_bmi_long.csv"
) %>%
mutate(id = as.factor(id), sex = as.factor(sex))
head(dat)
with(dat, plot(age, bmi))
dat %>% group_by(sex) %>% summarise(N = n_distinct(id))
dat %>%
group_by(id) %>%
count() %>%
ungroup() %>%
summarise(median(n), min(n), max(n))
summary(dat$age)
set.seed(2024)
bwt_sim <- dat %>%
distinct(id) %>%
mutate(BWT = rnorm(n(), mean = 3500, sd = 500))
bwt_breaks <- quantile(bwt_sim$BWT, probs = seq(0, 1, 0.25))
dat <- dat %>%
left_join(bwt_sim, by = "id") %>%
mutate(BWT_q = cut(
BWT,
breaks = bwt_breaks,
labels = c("Q1", "Q2", "Q3", "Q4"),
include.lowest = TRUE
))
ns_mf <- map(3:6, possibly(~ {
eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", .x, ") * sex + (age | id),
REML = FALSE, data = dat)"
)))
}, otherwise = NA_real_))
df_best <- (3:6)[which.min(unlist(map(ns_mf, BIC)))]
(ns_mf_best <- ns_mf[[which.min(unlist(map(ns_mf, BIC)))]])
attr(terms(ns_mf_best), "predvars")
anova(ns_mf_best)[3, ]
predict_response(ns_mf_best,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory by Sex") +
theme_classic()
pred_diff <- comparisons(
ns_mf_best,
variables = "sex",
newdata   = datagrid(age = seq(0.5, 7, by = 0.5))
) %>% as.data.frame()
ggplot(data = pred_diff,
aes(x = age, y = estimate, ymin = conf.low, ymax = conf.high)) +
theme_classic() +
geom_pointrange(size = 0.25) +
geom_hline(yintercept = 0, lty = 2, col = "red", linewidth = 0.1) +
scale_x_continuous(breaks = seq(0, 7, by = 1)) +
xlab("Age (years)") +
ylab("Predicted mean difference (Males minus Females)")
(ns_mf_bw <- eval(parse(text = paste0(
"lmer(bmi ~ ns(age, ", df_best, ") * (sex + BWT_q) + (age | id),
REML = FALSE, data = dat)"
))))
anova(ns_mf_bw)[5, ]
predict_response(ns_mf_bw,
terms  = c("age [all]", "BWT_q"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory by Birth Weight Quartile") +
theme_classic()
predict_response(ns_mf_bw,
terms  = c("age [all]", "BWT_q"),
margin = "marginalmeans")
predict_response(ns_mf_bw,
terms  = c("age [all]", "BWT_q", "sex"),
margin = "marginalmeans")
predict_response(ns_mf_bw,
terms  = c("age", "BWT_q"),
margin = "marginalmeans")
summary(dat$age)
predict_response(ns_mf_bw,
terms  = c("age [0.08:7.2 by=0.5]", "BWT_q"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory by Birth Weight Quartile") +
theme_classic()
predict_response(ns_mf_bw,
terms  = c("age [0.08:7.2 by=0.1]", "BWT_q"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory by Birth Weight Quartile") +
theme_classic()
predict_response(ns_mf_best,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Natural Spline Trajectory by Sex") +
theme_classic()
