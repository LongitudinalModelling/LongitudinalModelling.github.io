knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.width  = 8,
fig.height = 5
)
rm(list = ls())
install.packages(c(
"broom.mixed", "tidyverse", "lme4", "lmerTest", "lspline",
"ggeffects", "splines", "marginaleffects", "emmeans"
))
library(broom.mixed)        # tidy model summaries for mixed effects models
library(marginaleffects)    # marginal means, contrasts, and comparisons
library(lspline)
library(tidyverse)          # data manipulation and plotting
library(ggeffects)          # predicted values and plots from models
library(emmeans)            # estimated marginal means
library(splines)            # ns() for natural spline basis functions
library(lme4)               # linear mixed effects models
library(lmerTest)          # p-values for linear mixed effects models
dat <- read.csv(
"https://raw.githubusercontent.com/LongitudinalModelling/fake_datasets/main/gusto_growth_long.csv"
)
dat <- read.csv(
"https://raw.githubusercontent.com/LongitudinalModelling/fake_datasets/main/gusto_growth_long.csv"
)
with(dat, plot(age, bmi))
with(dat, plot(age, cbmi))
dat %>% group_by(sex) %>% summarise(N = n_distinct(id))
dat %>%
group_by(id) %>%
count() %>%
ungroup() %>%
summarise(median(n), min(n), max(n))
dat_m <- dat %>% filter(sex == "boys")
dat_f <- dat %>% filter(sex == "girls")
lspline_mod_f <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 3, 6)) + (age | id ), REML = F, data = dat_f)
(lspline_mod_f <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 3, 6)) + (age | id ), REML = F, data = dat_f))
print(c(min(dat_f$age), attr(lspline(dat_f$age, c(1/12, 3/12, 6/12, 1, 3, 6)), "knots"), max(dat_f$age)))
predict_response(lspline_mod_f,
terms  = c("age [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory in Females") +
theme_classic()
ls_mod_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 3, 6)) * sex + (age | id),
REML = F, data = dat)
(ls_mod_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 3, 6)) * sex + (age | id),
REML = F, data = dat))
anova(ls_mod_mf)[3, ]
predict_response(ls_mod_mf,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
(ls_mod_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 1.5, 6)) * sex + (age | id),
REML = F, data = dat))
predict_response(ls_mod_mf,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
(ls_mod_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + (age | id),
REML = F, data = dat))
predict_response(ls_mod_mf,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.width  = 8,
fig.height = 5
)
library(broom.mixed)        # tidy model summaries for mixed effects models
library(marginaleffects)    # marginal means, contrasts, and comparisons
library(lspline)
library(tidyverse)          # data manipulation and plotting
library(ggeffects)          # predicted values and plots from models
library(emmeans)            # estimated marginal means
library(splines)            # ns() for natural spline basis functions
library(lme4)               # linear mixed effects models
library(lmerTest)          # p-values for linear mixed effects models
dat <- read.csv(
"https://raw.githubusercontent.com/LongitudinalModelling/fake_datasets/main/gusto_growth_long.csv"
)
head(dat)
with(dat, plot(age, cbmi))
dat %>% group_by(sex) %>% summarise(N = n_distinct(id))
dat %>%
group_by(id) %>%
count() %>%
ungroup() %>%
summarise(
median(n), min(n), max(n))
summary(dat$age)
(ls_mod_bw_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * BWT + (age | id),
REML = F, data = dat))
(ls_mod_bw_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * BWT + (age | id), control = lmerControl(autoscale = TRUE),
REML = F, data = dat))
anova(ls_mod_bw_mf)
anova(ls_mod_bw_mf)
anova(ls_mod_bw_mf)[5, ]
(ls_mod_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + (age | id),
REML = F, data = dat))
as.data.frame(tidy(ls_mod_mf, conf.int = T)) %>%filter(effect == "fixed") %>% select(-group)
as.data.frame(tidy(ls_mod_bw_mf, conf.int = T)) %>%filter(effect == "fixed") %>% select(-group)
as.data.frame(tidy(ls_mod_bw_mf, conf.int = T)) %>%filter(effect == "fixed") %>% select(-group)
as.data.frame(tidy(ls_mod_mf, conf.int = T)) %>%filter(effect == "fixed") %>% select(-group)
as.data.frame(tidy(ls_mod_bw_mf, conf.int = T)) %>%filter(effect == "fixed") %>% select(-group)
with(dat, plot(age, cbmi))
dat %>% group_by(sex) %>% summarise(N = n_distinct(id))
dat %>%
group_by(id) %>%
count() %>%
ungroup() %>%
summarise(
median(n), min(n), max(n))
summary(dat$age)
summary(dat$BWT)
predict_response(ls_mod_mf,
terms  = c("age [all]", "BWT [2800 3100 5400]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
predict_response(ls_mod_mf,
terms  = c("age [all]", "sex [all]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
predict_response(ls_mod_bw_mf,
terms  = c("age [all]", "BWT [2800 3100 5400]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by Sex") +
theme_classic()
ls_mod_bw_mf
predict_response(ls_mod_bw_mf,
terms  = c("age [all]", "BWT [2800 3100 5400]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by BWT") +
theme_classic()
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.width  = 8,
fig.height = 5
)
library(broom.mixed)        # tidy model summaries for mixed effects models
library(marginaleffects)    # marginal means, contrasts, and comparisons
library(lspline)
library(tidyverse)          # data manipulation and plotting
library(ggeffects)          # predicted values and plots from models
library(emmeans)            # estimated marginal means
library(splines)            # ns() for natural spline basis functions
library(lme4)               # linear mixed effects models
library(lmerTest)          # p-values for linear mixed effects models
dat <- read.csv(
"https://raw.githubusercontent.com/LongitudinalModelling/fake_datasets/main/gusto_growth_long.csv"
)
head(dat)
(ls_mod_bw_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * BWT + (age | id),
REML = F, data = dat))
predict_response(ls_mod_bw_mf,
terms  = c("age [all]", "BWT [2800 3100 5400]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by BWT") +
theme_classic()
(ls_mod_bw_mf <- lmer(cbmi ~ lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * sex + lspline(age, c(1/12, 3/12, 6/12, 1, 6)) * BWT + (age | id), control = lmerControl(autoscale = TRUE),
REML = F, data = dat))
predict_response(ls_mod_bw_mf,
terms  = c("age [all]", "BWT [c(2800, 3100, 5400)]"),
margin = "marginalmeans") %>%
plot() +
ggtitle("Predicted Mean BMI Linear Spline Trajectory by BWT") +
theme_classic()
